package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

aconfig_declarations {
    name: "d2d_connectivity_aconfig_flags",
    package: "android.bettertogether.flags",
    container: "system",
    exportable: true,
    srcs: ["d2d_connectivity.aconfig"],
    visibility: [
        "//packages/modules/BetterTogether:__subpackages__",
        "//cts/tests/tests/bettertogether:__subpackages__",
        "//frameworks/base:__subpackages__",
    ],
}

rust_aconfig_library {
    name: "libd2d_connectivity_aconfig_flags_rust",
    crate_name: "d2d_connectivity_aconfig_flags_rust",
    aconfig_declarations: "d2d_connectivity_aconfig_flags",
    min_sdk_version: "37",
    host_supported: true,
    visibility: [
        "//packages/modules/BetterTogether:__subpackages__",
    ],
}

java_aconfig_library {
    name: "d2d_connectivity_aconfig_flags_java",
    aconfig_declarations: "d2d_connectivity_aconfig_flags",
    sdk_version: "module_current",
    min_sdk_version: "37",
    installable: false,
    visibility: [
        "//cts/tests/tests/bettertogether:__subpackages__",
        "//packages/modules/BetterTogether:__subpackages__",
    ],
    apex_available: [
        "//apex_available:platform",
        "com.android.bettertogether",
    ],
}

java_aconfig_library {
    name: "com.android.bettertogether.d2d_connectivity_aconfig_exported",
    aconfig_declarations: "d2d_connectivity_aconfig_flags",
    mode: "exported",
    defaults: ["framework-minus-apex-aconfig-java-defaults"],
    visibility: [
        "//frameworks/base:__subpackages__",
    ],
}
